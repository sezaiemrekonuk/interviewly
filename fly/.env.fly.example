# P05 — the template for a local, gitignored `.env.fly`. Copy it, fill it from the managed
# dependencies you create, then `fly secrets import` it per app. Never commit the filled copy;
# `.gitignore` already carries `.env.fly`.
#
# This file holds RUNTIME configuration only. The three NEXT_PUBLIC_* keys are absent on
# purpose — they are build arguments, live in fly/web.toml, and were inlined into the bundle
# when the image was built. Adding them here would create the illusion of configuration while
# the bundle keeps its fallbacks.
#
# Which app gets which keys:
#   api     — all of it
#   worker  — all of it
#   web     — PUBLIC_ORIGIN, INTERNAL_API_URL (already in web.toml), NODE_ENV
#   edge    — none. S3_BUCKET is in fly/edge.toml and nothing else belongs there.

# ---- Core ----
NODE_ENV=production
# The edge's public hostname. Google OAuth, mail links and the session cookie domain all derive
# from it; a stale value here sends verification mail pointing at localhost.
PUBLIC_ORIGIN=https://interviewly-edge.fly.dev
INTERNAL_API_URL=http://interviewly-api.internal:4000
API_PORT=4000
# Two hops: the Fly proxy, then Caddy. Set in fly/api.toml; repeated here only as a reminder
# that it is one of the three settings that fail silently.
TRUST_PROXY=2

# ---- Database / cache ----
# `fly postgres create` prints this once, as postgres://…@<pgapp>.flycast:5432/interviewly.
DATABASE_URL=
# Prisma reads this key even though `migrate deploy` never uses a shadow database — `migrate dev`
# does, and env.ts requires the key to be present. Point it at the same instance with the
# `_shadow` database name; nothing in this deployment writes to it.
SHADOW_DATABASE_URL=
# Upstash, via `fly redis create`. Use the rediss:// (TLS) URL it prints.
#
# THIS IS THE CEILING (ADR-P09). sse.ts:180 opens one `redis.duplicate()` per open SSE stream,
# so concurrent interviews consume Redis connections 1:1. Whatever plan you pick here bounds
# concurrency before api machines do — record the plan's connection limit, P06 needs it.
REDIS_URL=
WORKER_HEALTH_PORT=4100
SEED_ADMIN_PASSWORD=

# ---- Auth ----
# 32 chars minimum, and NOT the .env.example placeholder — env.ts:135 refuses to boot a deployed
# origin that still carries it. Generate: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_DAYS=7
# The second setting that fails silently. Left false behind a real TLS proxy, the session cookie
# ships without `Secure` over a public origin and nothing in the app notices (issue #118).
SESSION_COOKIE_SECURE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# ---- Mail ----
# Mandatory. Registration always enqueues a mail, so a stack without a sink dead-letters a job on
# the first signup. Mailpit is not deployed. Resend over implicit TLS on 465 (see
# worker/src/jobs/email-send.ts); SMTP_USER is the literal string `resend`.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
# The domain must be verified in Resend. `onboarding@resend.dev` needs no verification but
# delivers only to the Resend account owner's own address — enough for the P05 walk-through.
MAIL_FROM="Interviewly <onboarding@resend.dev>"

# ---- LLM providers ----
# AI_ENABLED is true on this deploy (below), so these are billed for real. P06's load runs use a
# different, explicitly load-test env; this app must not quietly ship one.
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- Voice ----
# Required whenever AI_ENABLED=true — env.ts fails startup on an empty value rather than
# downgrading an interview to text (issue #56).
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_STT_MODEL=scribe_v1
VOICE_MAX_ROUND_SECONDS=720
VOICE_MAX_INTERVIEW_SECONDS=1500

# ---- Storage (Tigris) ----
# `fly storage create` prints all five. The bucket name is globally unique and is NOT
# `interviewly` — fly/edge.toml's S3_BUCKET must carry the same value the rewrite depends on it.
S3_ENDPOINT=https://fly.storage.tigris.dev
S3_BUCKET=
S3_REGION=auto
S3_PUBLIC_PREFIX=/assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
SIGNED_URL_TTL=300

# ---- Cost guards ----
# The third setting that fails silently is not here but in what is absent: SPEECH_PROVIDER and
# LOADTEST are deliberately unset, so P02's guard leaves the live speech provider in place.
AI_ENABLED=true
BUDGET_USD_TEXT=1.50
MAX_INTERVIEWS_PER_USER_PER_DAY=5
CONDUCTOR_MAX_TURNS_PER_QUESTION=3
CONDUCTOR_MAX_TURNS=80

# ---- Observability ----
LOG_LEVEL=info
# No Elasticsearch in this deployment; `fly logs` is the reader. ELASTICSEARCH_URL is omitted
# rather than pointed at a host that does not exist.
LOG_TRANSPORT=stdout
