http://localhost {
    handle_path /api/* {
        reverse_proxy api:4000
    }
    handle /events/* {
        reverse_proxy api:4000 {
            flush_interval -1
        }
    }
    handle /webhooks/* {
        reverse_proxy api:4000
    }
    # S3 puts the bucket in the path, so `/assets/mascot/x.webp` has to reach the bucket as
    # `/interviewly/mascot/x.webp`. Proxying the URL unchanged made MinIO read "assets" as the
    # bucket name and 404 every avatar and mascot.
    handle_path /assets/* {
        rewrite * /{$S3_BUCKET:interviewly}{uri}
        reverse_proxy bucket:9000
    }
    handle /{$S3_BUCKET:interviewly}/* {
        reverse_proxy bucket:9000
    }
    handle {
        reverse_proxy web:3000
    }

    # CSP is set per-request by frontend/src/middleware.ts (needs a per-request nonce
    # for Next's inline hydration scripts) — setting it here too would clobber that.
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
}
