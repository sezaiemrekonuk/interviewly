http://localhost {
    handle_path /api/* {
        reverse_proxy api:4000
    }
    handle /events/* {
        reverse_proxy api:4000 {
            flush_interval -1
        }
    }
    handle /webhooks/* {
        reverse_proxy api:4000
    }
    handle /assets/* {
        reverse_proxy bucket:9000
    }
    handle {
        reverse_proxy web:3000
    }

    # CSP is set per-request by frontend/src/middleware.ts (needs a per-request nonce
    # for Next's inline hydration scripts) — setting it here too would clobber that.
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
}
