{
  // This config no longer typechecks any workspace's shippable source — `npm run typecheck`
  // runs each of frontend/, backend/, worker/, packages/*/'s OWN tsconfig for that (their real
  // `module`/`moduleResolution`, the ones `tsc -p` actually builds with). Checking backend/src
  // here too, under `module: esnext`, is what let I08 ship top-level `await` clean through this
  // config and red through backend's own commonjs build — one program cannot serve both.
  // What's left has no workspace tsconfig of its own: prisma/seed.ts and the cucumber step
  // definitions run through `tsx` (module setting irrelevant to execution), and the
  // integration tests below are the ones no other command reads with `tsc` at all.
  "compilerOptions": {
    "target": "ES2022",
    // dom/dom.iterable stay: the cucumber world's `httpPost`/`httpGet` etc. use the global
    // `fetch`/`Response`, and dropping this lib swaps `Response.json()` from dom's `Promise<any>`
    // to Node's own ambient `Promise<unknown>` — an unrelated type error, not the module-target
    // fix this config exists for.
    "lib": ["ES2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@interviewly/ai": ["packages/ai/src/index.ts"]
    }
  },
  "include": [
    "backend/prisma",
    "backend/features",
    // Not all of backend/modules: its unit tests carry loose mock typings that pass at runtime,
    // because vitest transpiles without checking, and cleaning them up is its own job. The
    // INTEGRATION files are here because nothing else can catch them — they are excluded from
    // `npm test`, so a wrong Prisma fixture in one stays invisible until the CI acceptance job
    // runs it. That is exactly how issue 196's test first shipped, missing a required column.
    "backend/modules/**/*.integration.test.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/.next"]
}
