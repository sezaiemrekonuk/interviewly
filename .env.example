# ---- Core ----
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost
API_PORT=4000
# Number of proxy hops to trust for X-Forwarded-For. 1 = one Caddy hop (compose production).
# Set to false or 0 when the API is reachable without the edge proxy (compose.dev.yaml port 4000),
# or to the IP/CIDR of your edge proxy to restrict spoofing to that proxy only.
TRUST_PROXY=1
INTERNAL_API_URL=http://api:4000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ---- Database / cache ----
DATABASE_URL=postgresql://interviewly:interviewly@db:5432/interviewly
SHADOW_DATABASE_URL=postgresql://interviewly:interviewly@db:5432/interviewly_shadow
REDIS_URL=redis://cache:6379
# Issue 71 — port the worker serves /healthz on, for the compose healthcheck. Bound to the
# container's loopback and never published; nothing outside the container reaches it.
WORKER_HEALTH_PORT=4100
# F02 seed only — the demo admin's password (admin@demo.com). Local demo credential.
SEED_ADMIN_PASSWORD=AdminDemo1!

# ---- Auth ----
SESSION_SECRET=change-me-32-chars-minimum-xxxxxxxx
SESSION_TTL_DAYS=7
# Stays `true` here. This file is what `cp .env.example .env` produces — CI does it and, per
# issue #118, so did the live deployment — so a `false` in this line is a deployment shipping
# its session cookie in clear. The local HTTP stack gets its override from compose.dev.yaml,
# which is opt-in and cannot reach a real environment. No longer tied to NODE_ENV, which is a
# build concern rather than a transport one (issue #69).
SESSION_COOKIE_SECURE=true
# Both empty means no Google sign-in on this deployment, which is a supported state and not a
# broken one: `GET /auth/capabilities` reports it and the button is never drawn (issue #60).
# To turn it on, create an OAuth 2.0 Client ID (type: Web application) in the Google Cloud
# console and register this exact Authorized redirect URI — the `/api` is the browser-facing
# prefix the edge strips, and Google matches the string character for character:
#
#   ${PUBLIC_ORIGIN}/api/auth/google/callback   e.g. http://localhost/api/auth/google/callback
#
# The `api` container reads this file at start, so `docker compose up -d api` picks it up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# K8.6 — gates POST /interviews only. Ships false: SETUP.md must never need an inbox.
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# ---- Mail (K8.6) ----
# Dev: the `mail` container. Read the link at http://localhost:8025 (compose.dev.yaml).
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Interviewly <no-reply@interviewly.local>"
# Real delivery via Resend — same nodemailer path, no code change. Port 465 selects
# implicit TLS (see worker/src/jobs/email-send.ts); SMTP_USER is the literal `resend`.
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USER=resend
#   SMTP_PASSWORD=re_...            # a Resend API key, never committed
# MAIL_FROM's domain must be verified in Resend. `onboarding@resend.dev` works without
# verification but only delivers to the Resend account owner's own address.
#   MAIL_FROM="Interviewly <no-reply@yourdomain.com>"

# ---- LLM providers ----
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- Voice ----
# Left empty on purpose, and it boots: env.ts requires this key only when AI_ENABLED=true,
# which is false below. Fill it in the same edit that flips that flag — with voice on, an
# empty value fails at startup rather than downgrading an interview to text (issue #56).
ELEVENLABS_API_KEY=
# turbo_v2_5: ~3x faster than multilingual_v2, indistinguishable EN/TR (L01, ADR-L03).
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_STT_MODEL=scribe_v1
VOICE_MAX_ROUND_SECONDS=720
VOICE_MAX_INTERVIEW_SECONDS=1500

# ---- Storage ----
S3_ENDPOINT=http://bucket:9000
S3_BUCKET=interviewly
# Ignored by MinIO, required by real S3 — set it to the bucket's actual region there.
S3_REGION=us-east-1
S3_PUBLIC_PREFIX=/assets
# Browser-side mirror of S3_PUBLIC_PREFIX + the mascot artwork digest (W03 <Mascot>).
# Defaults match the seeded placeholder set, so a fresh clone needs neither.
NEXT_PUBLIC_ASSETS_PREFIX=/assets
NEXT_PUBLIC_MASCOT_SHA256=86be52bdb7547413cafb3ed175a806a798c65de98b40849e0b974c47d187de65
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
SIGNED_URL_TTL=300

# ---- Cost guards ----
# Off in the example so a fresh clone boots with no keys at all: with AI_ENABLED=true the
# API validates every provider named by a prompt file at startup and refuses to serve if one
# has no key (B7). Fill OPENAI_API_KEY above and flip this to true for real generation.
AI_ENABLED=false
# Raised from 0.50 by C02. The conductor spends per candidate utterance with the conversation
# replayed, so an interview's cost now tracks how much was said rather than how many questions
# were planned — at 0.50 a talkative candidate was ended mid-interview by the budget guard.
BUDGET_USD_TEXT=1.50
MAX_INTERVIEWS_PER_USER_PER_DAY=5
# C02 backstops. The first is the hard drift ceiling, in candidate utterances against one
# question: the last one is spent closing the question rather than probing again, so 3 means one
# answer plus at most one follow-up. The second bounds the whole interview in utterances, for a
# provider that answers cheaply and wrongly forever.
CONDUCTOR_MAX_TURNS_PER_QUESTION=3
CONDUCTOR_MAX_TURNS=80

# ---- Observability ----
LOG_LEVEL=info
LOG_TRANSPORT=stdout
ELASTICSEARCH_URL=http://elasticsearch:9200
