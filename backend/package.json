  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "pino": "^9",
    "zod": "^3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  }
}
