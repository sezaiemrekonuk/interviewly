{
  "name": "@interviewly/backend",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "cd .. && eslint --config eslint.config.js backend/src",
    "seed": "tsx prisma/seed.ts",
    "db:check": "tsx src/lib/db.ts",
