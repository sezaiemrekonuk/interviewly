// Interviewly — complete persistent data model (F02, db spec 2026-07-29).
//
// The ENTIRE schema lands here, including tables no feature ledger has reached yet (K13).
// After this file is merged, feature ledgers may add INDEXES and NULLABLE COLUMNS only,
// each in its own timestamped migration, rebased before merge (§5.2). A new table, a
// dropped column, a changed relation or a new enum value is a change to F02's scope:
// discussed in the group, recorded as an ADR, merged as its own task.
//
// Every foreign key is ON DELETE RESTRICT. There are no cascades anywhere, by design —
// deletion is soft (`interviews.deleted_at`) or never. RESTRICT is a guard, not a workflow.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — Postgres native enum types, so membership is enforced by the database.
// Adding a value is a structural change and therefore an F02 change (db spec §10).
// ---------------------------------------------------------------------------

enum Role {
  user
  admin
}

enum InterviewMode {
  voice
  text
}

enum JobSource {
  paste
  upload
}

enum InterviewState {
  created
  profiling
  hr_round
  tech_round
  paused
  evaluating
  completed
  abandoned
  failed
}

enum EndedReason {
  completed
  cut_short
  budget_exhausted
  time_exhausted
  abandoned
  error
}

enum RoundType {
  hr
  tech
}

enum RoundStatus {
  pending
  active
  done
}

/// §3.9 — provisionally owned by backend/ai; a change here is an F02 change.
enum QuestionKind {
  open
  behavioral
  technical
  widget
}

/// K4 — ordered easy < medium < hard.
enum Difficulty {
  easy
  medium
  hard
}

enum InputMode {
  voice
  text
  widget
}

enum ReportStatus {
  queued
  generating
  ready
  failed
}

/// K4 — why the selector picked this question over its two candidates.
enum ChosenReason {
  score_low
  score_mid
  score_high
  language_switch
  fallback
}

enum UnitKind {
  token
  second
  character
}

/// §3.6 — the five avatar states. Keys of `personas.avatar_set`; no column binds it.
enum AvatarState {
  idle
  listening
  thinking
  speaking
  acknowledging
}

/// §4.2.1 — the shared mascot set. Declared, deliberately NOT attached to any column:
/// the mascot set is one seeded asset group, not per-row data. It exists as an enum so
/// `prisma/seed.ts` and the frontend cannot disagree about the five storage keys.
enum MascotPose {
  wave
  point
  think
  cheer
  shrug
}

/// Provisionally owned by backend's interview module; a change here is an F02 change.
enum ChatRole {
  user
  assistant
  system
}

/// K8.6 — one `email_tokens` table serves both flows.
enum EmailTokenKind {
  verify
  reset
}

/// K12, §3.3 — what role an uploaded object played.
enum UploadKind {
  listing
  cv
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id                      String    @id @default(cuid())
  email_lower             String    @unique
  password_hash           String?
  google_sub              String?   @unique
  role                    Role      @default(user)
  locale                  String    @default("en")
  email_verified_at       DateTime? // K8.6
  profile                 Json? // §3.3 layer 1 — partial is normal, `null` means every card was skipped
  cv_upload_id            String? // §3.3 — a pointer, not a history: a new CV repoints it
  onboarding_completed_at DateTime? // K8.7
  // KVKK / GDPR Art. 13 (issue 009) — *which* version of the policy this account accepted,
  // and when. Null on every account created before consent existed; a bumped
  // `CONSENT_VERSION` is what makes an old acceptance visibly old rather than silently stale.
  consent_version         String?
  consented_at            DateTime?
  // KVKK Art. 7 / GDPR Art. 17 erasure marker. The row survives (every FK is RESTRICT) but
  // is anonymised in place by `auth/delete-account.ts`; this column is the proof and the
  // handle a later retention job removes the anonymous shell by.
  deleted_at              DateTime?
  created_at              DateTime  @default(now())

  cv_upload    Upload?      @relation("UserCv", fields: [cv_upload_id], references: [id], onDelete: Restrict)
  sessions     Session[]
  email_tokens EmailToken[]
  interviews   Interview[]
  uploads      Upload[]     @relation("UploadOwner")

  @@map("users")
}

model Session {
  id         String    @id @default(cuid())
  user_id    String
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)

  // A05: password reset revokes every session of one user in a single UPDATE.
  @@index([user_id])
  @@map("sessions")
}

/// K8.6 — holds sha256(token), never the token. Consumption is a guarded update on
/// `consumed_at`; a consumed or expired row is retained so the audit survives.
model EmailToken {
  id          String         @id @default(cuid())
  user_id     String
  kind        EmailTokenKind
  token_hash  String         @unique
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime       @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id, kind]) // K8.6 — cooldown / latest-token lookups
  @@map("email_tokens")
}

model Persona {
  id            String  @id @default(cuid())
  role          String
  name          String
  voice_id      String
  avatar_set    Json // { [AvatarState]: storageKey } under `personas/{id}/` (§3.6)
  system_prompt String
  active        Boolean @default(true)

  interview_rounds InterviewRound[]

  @@map("personas")
}

/// Seeded reference table. `interviews.occupation_cluster_id` FKs here so K11's admin
/// grouping has a stable key. The canonical list is written by `prisma/seed.ts`.
model OccupationCluster {
  id    String @id @default(cuid())
  key   String @unique
  label String

  interviews Interview[]

  @@map("occupation_clusters")
}

model Interview {
  id                    String         @id @default(cuid())
  user_id               String
  mode                  InterviewMode
  job_text              String
  job_source            JobSource
  upload_id             String?
  occupation            String
  occupation_cluster_id String?
  language              String
  candidate_profile     Json? // §3.3 — merged snapshot, never `{}`
  // 1..20, enforced by the `interviews_target_question_count_range` CHECK constraint (issue
  // #98) — Prisma cannot express it, so it lives in the migration and is repeated in setup.ts.
  target_question_count Int
  hr_question_count     Int
  state                 InterviewState @default(created)
  current_index         Int            @default(0)
  ended_reason          EndedReason?
  budget_usd            Decimal        @default(0.50) @db.Decimal(12, 6)
  spent_usd             Decimal        @default(0) @db.Decimal(12, 6)
  started_at            DateTime?
  ended_at              DateTime?
  deleted_at            DateTime? // the soft-delete column user-facing reads filter on (K13)
  created_at            DateTime       @default(now())

  user               User               @relation(fields: [user_id], references: [id], onDelete: Restrict)
  upload             Upload?            @relation(fields: [upload_id], references: [id], onDelete: Restrict)
  occupation_cluster OccupationCluster? @relation(fields: [occupation_cluster_id], references: [id], onDelete: Restrict)
  interview_rounds   InterviewRound[]
  reports            Report[]
  chat_messages      ChatMessage[]
  llm_calls          LlmCall[]

  @@index([user_id, created_at])
  @@index([occupation_cluster_id]) // K11 admin grouping key
  @@index([state])
  @@map("interviews")
}

model InterviewRound {
  id           String      @id @default(cuid())
  interview_id String
  type         RoundType
  persona_id   String
  status       RoundStatus @default(pending)
  score        Int?

  interview Interview  @relation(fields: [interview_id], references: [id], onDelete: Restrict)
  persona   Persona    @relation(fields: [persona_id], references: [id], onDelete: Restrict)
  questions Question[]

  @@unique([interview_id, type])
  @@map("interview_rounds")
}

model Question {
  id            String        @id @default(cuid())
  round_id      String
  order_index   Int
  text          String
  kind          QuestionKind
  difficulty    Difficulty
  topic         String
  candidates    Json? // K4's two unselected candidates, retained for admin analysis
  chosen_reason ChosenReason?
  asked_at      DateTime?

  round            InterviewRound   @relation(fields: [round_id], references: [id], onDelete: Restrict)
  answers          Answer[]
  report_questions ReportQuestion[]

  @@unique([round_id, order_index]) // order_index is unique within a round
  @@map("questions")
}

model Answer {
  id          String    @id @default(cuid())
  question_id String
  transcript  String
  input_mode  InputMode
  started_at  DateTime?
  answered_at DateTime?
  duration_ms Int?
  scores      Json? // K4 — { overall, relevance, depth, structure, star_adherence, reasons[] }

  question Question @relation(fields: [question_id], references: [id], onDelete: Restrict)

  @@map("answers")
}

model Report {
  id             String       @id @default(cuid())
  /// Unique (issue 082): one report per interview, so a retried job upserts instead of
  /// adding a second row.
  interview_id   String       @unique
  status         ReportStatus @default(queued)
  payload        Json? // K15 Zod schema
  pdf_key        String?
  prompt_uuid    String
  prompt_version Int
  created_at     DateTime     @default(now())

  interview        Interview        @relation(fields: [interview_id], references: [id], onDelete: Restrict)
  report_questions ReportQuestion[]

  @@map("reports")
}

/// Denormalises K15's `questions[]` so the K11 admin "weakest questions" statistic is a
/// plain relational query with no jsonb traversal.
model ReportQuestion {
  id             String  @id @default(cuid())
  report_id      String
  question_id    String
  score          Int
  reason         String
  star_adherence Decimal @db.Decimal(3, 2)

  report   Report   @relation(fields: [report_id], references: [id], onDelete: Restrict)
  question Question @relation(fields: [question_id], references: [id], onDelete: Restrict)

  /// Issue 082: a question is scored once per report, so a concurrent rewrite cannot double it.
  @@unique([report_id, question_id])
  @@map("report_questions")
}

model Upload {
  id          String     @id @default(cuid())
  user_id     String
  kind        UploadKind // K12, §3.3 — listing | cv
  storage_key String
  mime        String
  size_bytes  Int
  // K12 dedups on the bytes, but the row is one *user's* upload record, so the key is
  // (owner, bytes) — see the `@@unique` below. A globally unique sha256 handed the second
  // uploader of an identical file a row owned by the first, which `setup.ts`'s ownership
  // check then refused: the upload answered 201 and the interview it was for was impossible.
  sha256      String
  // The name the file had on the uploader's machine, sanitised. Display only — never a path
  // and never the storage key, which stays content-addressed. Nullable: every row written
  // before this column existed has none, and a deduped upload keeps whatever it was first
  // stored under.
  filename    String?
  created_at  DateTime   @default(now())

  user       User        @relation("UploadOwner", fields: [user_id], references: [id], onDelete: Restrict)
  cv_of      User[]      @relation("UserCv")
  interviews Interview[]

  // One row per (owner, bytes). The bytes themselves are still stored once: `storage_key` is
  // `uploads/<sha256>.pdf`, so two users' rows for an identical file address one object.
  @@unique([user_id, sha256])
  @@index([user_id, kind]) // §3.3 — "this user's CV" without a table scan
  @@map("uploads")
}

model ChatMessage {
  id           String   @id @default(cuid())
  interview_id String
  role         ChatRole
  content      String
  trace_id     String // joins a K6 log line's traceId to the row that produced it
  created_at   DateTime @default(now())

  interview Interview @relation(fields: [interview_id], references: [id], onDelete: Restrict)

  @@map("chat_messages")
}

model LlmCall {
  id             String   @id @default(cuid())
  interview_id   String
  provider       String
  model          String
  prompt_uuid    String
  prompt_version Int
  attempt_no     Int
  fell_back_from String?
  units          Decimal  @db.Decimal(12, 3)
  unit_kind      UnitKind
  input_tokens   Int?
  output_tokens  Int?
  cost_usd       Decimal  @db.Decimal(12, 6)
  latency_ms     Int
  trace_id       String
  created_at     DateTime @default(now())

  interview Interview @relation(fields: [interview_id], references: [id], onDelete: Restrict)

  @@index([interview_id])
  @@map("llm_calls")
}
