// Interviewly — complete persistent data model (F02, db spec 2026-07-29).
//
// The ENTIRE schema lands here, including tables no feature ledger has reached yet (K13).
// After this file is merged, feature ledgers may add INDEXES and NULLABLE COLUMNS only,
// each in its own timestamped migration, rebased before merge (§5.2). A new table, a
// dropped column, a changed relation or a new enum value is a change to F02's scope:
// discussed in the group, recorded as an ADR, merged as its own task.
//
// Every foreign key is ON DELETE RESTRICT. There are no cascades anywhere, by design —
// deletion is soft (`interviews.deleted_at`) or never. RESTRICT is a guard, not a workflow.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — Postgres native enum types, so membership is enforced by the database.
// Adding a value is a structural change and therefore an F02 change (db spec §10).
// ---------------------------------------------------------------------------

enum Role {
  user
  admin
}

enum InterviewMode {
  voice
  text
}

enum JobSource {
  paste
  upload
}

enum InterviewState {
  created
  profiling
  hr_round
  tech_round
  paused
  evaluating
  completed
  abandoned
  failed
}

enum EndedReason {
  completed
  cut_short
  budget_exhausted
  time_exhausted
  abandoned
  error
}

enum RoundType {
  hr
  tech
}

enum RoundStatus {
  pending
  active
  done
}

/// §3.9 — provisionally owned by backend/ai; a change here is an F02 change.
enum QuestionKind {
  open
  behavioral
  technical
  widget
}

/// K4 — ordered easy < medium < hard.
enum Difficulty {
  easy
  medium
  hard
}

enum InputMode {
  voice
  text
  widget
}

enum ReportStatus {
  queued
  generating
  ready
  failed
}

/// K4 — why the selector picked this question over its two candidates.
enum ChosenReason {
  score_low
  score_mid
  score_high
  language_switch
  fallback
}

enum UnitKind {
  token
  second
  character
}

/// §3.6 — the five avatar states. Keys of `personas.avatar_set`; no column binds it.
enum AvatarState {
  idle
  listening
  thinking
  speaking
  acknowledging
}

/// §4.2.1 — the shared mascot set. Declared, deliberately NOT attached to any column:
/// the mascot set is one seeded asset group, not per-row data. It exists as an enum so
/// `prisma/seed.ts` and the frontend cannot disagree about the five storage keys.
enum MascotPose {
  wave
  point
  think
  cheer
  shrug
}

/// Provisionally owned by backend's interview module; a change here is an F02 change.
enum ChatRole {
  user
  assistant
  system
}

/// What the conductor decided at the end of a turn (ADR-C01). Stored on the assistant row
/// that carried the decision, so the interview's flow is readable from the conversation
/// alone — `continue` is a real value, not the absence of one, because "the interviewer
/// chose to stay on this question" and "nobody recorded a choice" are different facts.
///
/// `drift` is the one value the model cannot produce: the server writes it on the system row
/// it injects when the per-question ceiling is reached and the advance is forced.
enum ConductorAction {
  continue
  next_question
  handover
  end_interview
  show_widget
  drift
  /// C07 — the server refused what the interviewer asked for. Written on a system row so the
  /// next turn can read that it was overruled; a refusal the model cannot see is only a delay.
  refused
  /// T03 (ADR-T04) — thirteen seconds of silence. A system row rather than a null action so both
  /// turn ceilings can count it and `resolveMessages` can hide it from the room.
  silence
}

/// K8.6 — one `email_tokens` table serves both flows.
enum EmailTokenKind {
  verify
  reset
}

/// K12, §3.3 — what role an uploaded object played.
enum UploadKind {
  listing
  cv
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id                      String    @id @default(cuid())
  email_lower             String    @unique
  password_hash           String?
  google_sub              String?   @unique
  role                    Role      @default(user)
  locale                  String    @default("en")
  email_verified_at       DateTime? // K8.6
  profile                 Json? // §3.3 layer 1 — partial is normal, `null` means every card was skipped
  cv_upload_id            String? // §3.3 — a pointer, not a history: a new CV repoints it
  onboarding_completed_at DateTime? // K8.7
  // KVKK / GDPR Art. 13 (issue 009) — *which* version of the policy this account accepted,
  // and when. Null on every account created before consent existed; a bumped
  // `CONSENT_VERSION` is what makes an old acceptance visibly old rather than silently stale.
  consent_version         String?
  consented_at            DateTime?
  // KVKK Art. 7 / GDPR Art. 17 erasure marker. The row survives (every FK is RESTRICT) but
  // is anonymised in place by `auth/delete-account.ts`; this column is the proof and the
  // handle a later retention job removes the anonymous shell by.
  deleted_at              DateTime?
  created_at              DateTime  @default(now())

  cv_upload    Upload?      @relation("UserCv", fields: [cv_upload_id], references: [id], onDelete: Restrict)
  sessions     Session[]
  email_tokens EmailToken[]
  interviews   Interview[]
  uploads      Upload[]     @relation("UploadOwner")
  audit_logs   AuditLog[]

  @@map("users")
}

/// Issue 86 — the audit half of N01 ("role gate, soft delete, audit"), which was never built.
/// A NEW TABLE, so it is the §5.2 exception this file's header calls out: sanctioned by the
/// issue rather than smuggled in with a feature.
///
/// Until now the only record that an interview had been deleted was a pino line on stdout,
/// with no log volume mounted for `api` — so `docker compose down` erased it. `deleted_at`
/// said *that* something happened, never who did it. This is the durable, joinable,
/// queryable record; the pino lines stay, they are for tailing, not for truth.
///
/// NO PII, deliberately: ids and an action, never a password, token, session secret or raw
/// email address (the logger's contract, issue 063). `metadata` is for the same class of
/// thing — counts, states, flags.
///
/// Deliberately NOT here yet, and not an oversight: a retention policy for these rows, and
/// access control on reading them.
model AuditLog {
  id            String   @id @default(cuid())
  actor_user_id String
  /// Dotted `subject.verb`, e.g. `interview.soft_deleted` — see `src/lib/audit.ts`, which
  /// owns the closed set. A string and not an enum: a new action must not be a migration.
  action        String
  subject_type  String
  /// Null for a collection read — an admin listing a page of interviews acts on no single
  /// subject, and inventing one would make the column a lie.
  subject_id    String?
  /// Joins the row to the K6 log lines of the request that wrote it. Nullable because the
  /// Express augmentation types `req.traceId` optional; every HTTP path sets it.
  trace_id      String?
  metadata      Json?
  created_at    DateTime @default(now())

  actor User @relation(fields: [actor_user_id], references: [id], onDelete: Restrict)

  @@index([subject_type, subject_id]) // "everything that happened to this interview"
  @@index([actor_user_id, created_at]) // "everything this account did, newest first"
  @@map("audit_logs")
}

model Session {
  id         String    @id @default(cuid())
  user_id    String
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)

  // A05: password reset revokes every session of one user in a single UPDATE.
  @@index([user_id])
  @@map("sessions")
}

/// K8.6 — holds sha256(token), never the token. Consumption is a guarded update on
/// `consumed_at`; a consumed or expired row is retained so the audit survives.
model EmailToken {
  id          String         @id @default(cuid())
  user_id     String
  kind        EmailTokenKind
  token_hash  String         @unique
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime       @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id, kind]) // K8.6 — cooldown / latest-token lookups
  @@map("email_tokens")
}

model Persona {
  id            String  @id @default(cuid())
  role          String
  name          String
  voice_id      String
  avatar_set    Json // { [AvatarState]: storageKey } under `personas/{id}/` (§3.6)
  system_prompt String
  active        Boolean @default(true)

  interview_rounds InterviewRound[]

  @@map("personas")
}

/// Seeded reference table. `interviews.occupation_cluster_id` FKs here so K11's admin
/// grouping has a stable key. The canonical list is written by `prisma/seed.ts`.
model OccupationCluster {
  id    String @id @default(cuid())
  key   String @unique
  label String

  interviews Interview[]

  @@map("occupation_clusters")
}

model Interview {
  id                    String         @id @default(cuid())
  user_id               String
  mode                  InterviewMode
  job_text              String
  job_source            JobSource
  upload_id             String?
  occupation            String
  occupation_cluster_id String?
  language              String
  candidate_profile     Json? // §3.3 — merged snapshot, never `{}`
  // 1..20, enforced by the `interviews_target_question_count_range` CHECK constraint (issue
  // #98) — Prisma cannot express it, so it lives in the migration and is repeated in setup.ts.
  target_question_count Int
  // 0..target_question_count, enforced by the `interviews_hr_question_count_range` CHECK
  // constraint (issue #176) — the companion #98 could not add until the split had a floor.
  hr_question_count     Int
  // S08: the candidate's chosen voice length, in seconds. Null is "no choice" and leaves
  // `VOICE_MAX_INTERVIEW_SECONDS` as the ceiling; a value only ever caps downward
  // (`isPastSpeechCeiling`). Above the config ceiling is refused at setup, never clamped.
  max_duration_seconds  Int?
  state                 InterviewState @default(created)
  current_index         Int            @default(0)
  ended_reason          EndedReason?
  budget_usd            Decimal        @default(0.50) @db.Decimal(12, 6)
  spent_usd             Decimal        @default(0) @db.Decimal(12, 6)
  started_at            DateTime?
  ended_at              DateTime?
  deleted_at            DateTime? // the soft-delete column user-facing reads filter on (K13)
  created_at            DateTime       @default(now())

  user               User               @relation(fields: [user_id], references: [id], onDelete: Restrict)
  upload             Upload?            @relation(fields: [upload_id], references: [id], onDelete: Restrict)
  occupation_cluster OccupationCluster? @relation(fields: [occupation_cluster_id], references: [id], onDelete: Restrict)
  interview_rounds   InterviewRound[]
  reports            Report[]
  chat_messages      ChatMessage[]
  llm_calls          LlmCall[]

  @@index([user_id, created_at])
  @@index([occupation_cluster_id]) // K11 admin grouping key
  @@index([state])
  @@map("interviews")
}

model InterviewRound {
  id           String      @id @default(cuid())
  interview_id String
  type         RoundType
  persona_id   String
  status       RoundStatus @default(pending)
  score        Int?

  interview Interview  @relation(fields: [interview_id], references: [id], onDelete: Restrict)
  persona   Persona    @relation(fields: [persona_id], references: [id], onDelete: Restrict)
  questions Question[]

  @@unique([interview_id, type])
  @@map("interview_rounds")
}

model Question {
  id          String       @id @default(cuid())
  round_id    String
  order_index Int
  /// What was actually asked. Written by the batch as the fallback wording (C05) and
  /// overwritten by the conductor with the sentence it really said, so the report always
  /// quotes the interview rather than the plan.
  text        String
  kind        QuestionKind
  difficulty  Difficulty
  topic       String
  /// C05 — what this slot is *for*, in the interviewer's words ("find out how they handle
  /// a deadline they cannot meet"). The conductor writes the question from this; `text` is
  /// only the sentence to fall back to when there is no conductor to write one.
  intent      String?
  /// C04 — a typed answer surface the conductor put on screen for this question:
  /// `{ kind: 'textbox' | 'choice', label, options? }`. Null is the ordinary spoken or
  /// typed answer, which is most questions.
  widget      Json?

  candidates    Json? // K4's two unselected candidates, retained for admin analysis
  chosen_reason ChosenReason?
  asked_at      DateTime?

  round            InterviewRound   @relation(fields: [round_id], references: [id], onDelete: Restrict)
  answers          Answer[]
  report_questions ReportQuestion[]
  chat_messages    ChatMessage[]

  @@unique([round_id, order_index]) // order_index is unique within a round
  @@map("questions")
}

model Answer {
  id          String    @id @default(cuid())
  question_id String
  transcript  String
  input_mode  InputMode
  started_at  DateTime?
  answered_at DateTime?
  duration_ms Int?
  scores      Json? // K4 — { overall, relevance, depth, structure, star_adherence, reasons[] }

  question Question @relation(fields: [question_id], references: [id], onDelete: Restrict)

  @@map("answers")
}

model Report {
  id             String       @id @default(cuid())
  /// Unique (issue 082): one report per interview, so a retried job upserts instead of
  /// adding a second row.
  interview_id   String       @unique
  status         ReportStatus @default(queued)
  payload        Json? // K15 Zod schema
  pdf_key        String?
  prompt_uuid    String
  prompt_version Int
  created_at     DateTime     @default(now())

  interview        Interview        @relation(fields: [interview_id], references: [id], onDelete: Restrict)
  report_questions ReportQuestion[]

  @@map("reports")
}

/// Denormalises K15's `questions[]` so the K11 admin "weakest questions" statistic is a
/// plain relational query with no jsonb traversal.
model ReportQuestion {
  id             String  @id @default(cuid())
  report_id      String
  question_id    String
  score          Int
  reason         String
  star_adherence Decimal @db.Decimal(3, 2)

  report   Report   @relation(fields: [report_id], references: [id], onDelete: Restrict)
  question Question @relation(fields: [question_id], references: [id], onDelete: Restrict)

  /// Issue 082: a question is scored once per report, so a concurrent rewrite cannot double it.
  @@unique([report_id, question_id])
  /// Issue 143: the admin weakest-questions query is `ORDER BY score ASC, question_id ASC
  /// LIMIT 5`; both columns keep it an index scan instead of a full scan plus sort.
  @@index([score, question_id])
  @@map("report_questions")
}

model Upload {
  id          String     @id @default(cuid())
  user_id     String
  kind        UploadKind // K12, §3.3 — listing | cv
  storage_key String
  mime        String
  size_bytes  Int
  // K12 dedups on the bytes, but the row is one *user's* upload record, so the key is
  // (owner, bytes) — see the `@@unique` below. A globally unique sha256 handed the second
  // uploader of an identical file a row owned by the first, which `setup.ts`'s ownership
  // check then refused: the upload answered 201 and the interview it was for was impossible.
  sha256      String
  // The name the file had on the uploader's machine, sanitised. Display only — never a path
  // and never the storage key, which stays content-addressed. Nullable: every row written
  // before this column existed has none, and a deduped upload keeps whatever it was first
  // stored under.
  filename    String?
  created_at  DateTime   @default(now())

  user       User        @relation("UploadOwner", fields: [user_id], references: [id], onDelete: Restrict)
  cv_of      User[]      @relation("UserCv")
  interviews Interview[]

  // One row per (owner, bytes). The bytes themselves are still stored once: `storage_key` is
  // `uploads/<sha256>.pdf`, so two users' rows for an identical file address one object.
  @@unique([user_id, sha256])
  @@index([user_id, kind]) // §3.3 — "this user's CV" without a table scan
  @@map("uploads")
}

model ChatMessage {
  id           String           @id @default(cuid())
  interview_id String
  role         ChatRole
  content      String
  /// C01 — which question this utterance belongs to. Null for anything said outside a
  /// question's window: the opening welcome, and the handover line between rounds.
  ///
  /// This is what makes an answer recoverable. A conversational turn is many user messages
  /// per question, so `answers.transcript` is the join of every user row carrying this id —
  /// without it there is no way to tell a clarification apart from the answer it clarified.
  question_id  String?
  /// The conductor's decision for this turn; null on user rows, which decide nothing.
  action       ConductorAction?
  /// C07 — this utterance matched a §7.1 prompt-injection pattern. Evidence, not a summary:
  /// the report is allowed to quote the sentence rather than merely count it.
  flagged_injection Boolean         @default(false)
  trace_id     String // joins a K6 log line's traceId to the row that produced it
  created_at   DateTime         @default(now())

  interview Interview @relation(fields: [interview_id], references: [id], onDelete: Restrict)
  question  Question? @relation(fields: [question_id], references: [id], onDelete: Restrict)

  /// Replay reads one interview's messages in the order they were said, on every turn.
  @@index([interview_id, created_at])
  @@map("chat_messages")
}

model LlmCall {
  id             String   @id @default(cuid())
  interview_id   String
  provider       String
  model          String
  prompt_uuid    String
  prompt_version Int
  attempt_no     Int
  fell_back_from String?
  units          Decimal  @db.Decimal(12, 3)
  unit_kind      UnitKind
  input_tokens   Int?
  output_tokens  Int?
  cost_usd       Decimal  @db.Decimal(12, 6)
  latency_ms     Int
  trace_id       String
  created_at     DateTime @default(now())

  interview Interview @relation(fields: [interview_id], references: [id], onDelete: Restrict)

  @@index([interview_id])
  @@map("llm_calls")
}
